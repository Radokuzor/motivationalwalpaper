# Firebase Admin SDK service-account credentials (server-side only).
# Project Settings -> Service Accounts -> Generate new private key.
# Copy this file to .env (gitignored) for local dev; set the same three vars
# in Vercel -> Project Settings -> Environment Variables (all environments).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"

# Cloud Storage bucket — backs /submit wallpaper uploads (src/lib/wallpaperAssets.ts).
# Enable Storage for the Firebase project first, then paste the bucket id. Set this
# in Vercel env vars too or /submit and /api/wallpapers fail at runtime.
FIREBASE_STORAGE_BUCKET=motivewallpaper-220e4.firebasestorage.app

# Telegram bot notifications (src/lib/telegram.ts) — POST /api/analytics/session-end
# relays visitor-session summaries and abandoned-checkout alerts here. Create the
# bot via @BotFather (/newbot) for the token; send it /start then read
# https://api.telegram.org/bot<token>/getUpdates for the chat id (result[].message.chat.id).
# Server-only — never expose these with a NEXT_PUBLIC_/PUBLIC_ prefix.
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# /admin dashboard (src/lib/adminAuth.ts) — HTTP Basic Auth. ADMIN_USER
# defaults to "admin" if unset; ADMIN_PASSWORD is required or /admin 500s.
ADMIN_USER=admin
ADMIN_PASSWORD=
