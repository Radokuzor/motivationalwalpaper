---
/**
 * CategoryRail — Screen One's floating category menu (mobile / tablet only).
 *
 * A vertical stack of glass pills flush to the right edge, one per world. Same
 * dark-glass treatment as the pinned CTA so it whispers. Hidden >=900px, where
 * ThemeGrid's "All wallpapers" grid already fills the right half.
 *
 *  - emits  mw:category-open  { world }   (CategoryGrid opens the grid)
 *  - listens mw:reel-world                (mark the on-screen world as current)
 */
import { WORLDS } from '../data/worlds';
---

<nav class="cat-rail" aria-label="Wallpaper categories">
  {
    WORLDS.map((w) => (
      <button
        class="cat-btn"
        type="button"
        data-world={w.key}
        style={`--art:${w.art};`}
      >
        <i aria-hidden="true" />
        {w.name}
      </button>
    ))
  }
</nav>

<style>
  .cat-rail {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-end;
  }

  .cat-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 13px;
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-right: 0;
    border-radius: var(--r-pill) 0 0 var(--r-pill);
    background: rgba(0, 0, 0, 0.28);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    transition: background 0.16s ease;
  }
  .cat-btn i {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    flex: none;
    background: var(--art);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);
  }
  .cat-btn:active {
    background: rgba(0, 0, 0, 0.44);
  }
  .cat-btn.is-current {
    background: rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.6);
  }
  .cat-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* mobile layout with wider side gutters — hug the centred reel's edge */
  @media (min-width: 720px) and (max-width: 899px) {
    .cat-rail {
      right: calc(50% - 280px);
    }
  }

  /* desktop already has the "All wallpapers" grid */
  @media (min-width: 900px) {
    .cat-rail {
      display: none;
    }
  }
</style>

<script>
  import { MW, emit, on } from '../scripts/events';
  import type { WorldKey } from '../data/worlds';

  function init() {
    const rail = document.querySelector('.cat-rail');
    if (!rail) return;
    const btns = Array.from(
      rail.querySelectorAll<HTMLButtonElement>('.cat-btn'),
    );

    btns.forEach((btn) => {
      const world = btn.dataset.world as WorldKey | undefined;
      if (!world) return;
      btn.addEventListener('click', () => emit(MW.categoryOpen, { world }));
    });

    on(MW.reelWorld, (d) => {
      btns.forEach((b) =>
        b.classList.toggle('is-current', b.dataset.world === d.world),
      );
    });
  }

  init();
</script>
