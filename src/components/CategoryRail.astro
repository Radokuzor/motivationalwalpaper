---
/**
 * CategoryRail — Screen One's floating "Browse all" link (mobile / tablet only).
 *
 * A single glass pill flush to the right edge that opens the full gallery
 * page. Same dark-glass treatment as the pinned CTA so it whispers. Hidden
 * >=900px, where ThemeGrid's "All wallpapers" grid already fills the right
 * half.
 */
---

<a class="cat-rail" href="/gallery" aria-label="Browse all wallpaper categories">
  Browse all
</a>

<style>
  .cat-rail {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 13px;
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-right: 0;
    border-radius: var(--r-pill) 0 0 var(--r-pill);
    background: rgba(0, 0, 0, 0.28);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.16s ease;
  }
  .cat-rail:active {
    background: rgba(0, 0, 0, 0.44);
  }
  .cat-rail:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* mobile layout with wider side gutters — hug the centred reel's edge */
  @media (min-width: 720px) and (max-width: 899px) {
    .cat-rail {
      right: calc(50% - 280px);
    }
  }

  /* desktop already has the "All wallpapers" grid */
  @media (min-width: 900px) {
    .cat-rail {
      display: none;
    }
  }
</style>
