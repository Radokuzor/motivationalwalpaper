---
/**
 * BaseLayout — the <html> shell for every page.
 *
 * Owns <head> (meta, canonical, OG/Twitter, fonts) and the token + base CSS.
 * Renders nothing chrome-visible itself: lock-screen pages (index) use this
 * directly; content pages wrap it in ChromeLayout for the header/footer shell.
 */
import Analytics from '@vercel/analytics/astro';
import '../styles/tokens.css';
import '../styles/base.css';

export interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL. Defaults to this page's URL on Astro.site. */
  canonical?: string;
  /** Add <meta name="robots" content="noindex"> (skeleton pages). */
  noindex?: boolean;
  /** Absolute OG/Twitter image URL. Defaults to the site-wide share card. */
  image?: string;
  /** Extra class on <body>. */
  bodyClass?: string;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  noindex = false,
  image = new URL('/og/default.png', Astro.site).href,
  bodyClass,
} = Astro.props;

const FONTS_HREF =
  'https://fonts.googleapis.com/css2?family=Archivo:wght@800&family=Cormorant+Garamond:wght@600&family=IBM+Plex+Mono:wght@400;500&family=Lora:ital,wght@1,500&family=Mulish:wght@300&family=Orbitron:wght@700&family=Oswald:wght@500&family=Quicksand:wght@600&family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap';
// TODO(fonts): self-host the chrome faces (Schibsted Grotesk, IBM Plex Mono)
// via @fontsource in a later pass; keep the world display faces provisional.
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // swap no-js -> has-js before first paint so the wallpaper lines can start
      // hidden (they settle in as their panel lands); no JS = they just show.
      document.documentElement.classList.replace('no-js', 'has-js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="motivationalwallpaper.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="motivationalwallpaper.com — Blog" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS_HREF} />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <Analytics />
    <script>
      import { initAnalyticsTracker } from '../scripts/analyticsTracker';
      initAnalyticsTracker();
    </script>
  </body>
</html>
