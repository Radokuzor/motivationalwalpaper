---
/**
 * ChromeLayout — BaseLayout + the warm-paper chrome shell (header + footer,
 * centred measure). For every page that is NOT the lock-screen (quiz, gallery,
 * profile home, SEO landing pages, 404).
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  /** Constrain <main> to a readable measure (default true). */
  narrow?: boolean;
}
const { title, description, canonical, noindex, narrow = true } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={noindex}>
  <slot name="head" slot="head" />
  <div class="shell">
    <SiteHeader />
    <main class:list={['shell__main', narrow && 'shell__main--narrow']}>
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .shell {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  .shell__main {
    flex: 1;
    padding: 40px 24px 64px;
    width: 100%;
  }
  .shell__main--narrow {
    max-width: 760px;
    margin: 0 auto;
  }
</style>
