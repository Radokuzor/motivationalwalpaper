---
/**
 * Screen One (brand bible §07). The page opens AS an iOS lock screen: a
 * full-bleed wallpaper reel with the real overlay on top, a pinned "Send it to
 * my phone" CTA, and — on desktop — a browse-by-theme grid on the right.
 *
 * This page is only an orchestrator: Reel, ThemeGrid and CaptureSheet talk
 * through CustomEvents (src/scripts/events); nothing imports anything else.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Reel from '../components/Reel.astro';
import ThemeGrid from '../components/ThemeGrid.astro';
import CategoryRail from '../components/CategoryRail.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import CaptureSheet from '../components/CaptureSheet.astro';

const title = 'motivationalwallpaper — a lock screen you look forward to seeing';
const description =
  'A daily identity anchor for your phone. Pick a look that feels like who you are becoming, and we send it to your lock screen.';

// Sitewide entity graph — helps Google/Gemini/other AI crawlers resolve the
// brand as a single entity (01_strategy_brief.md "Gemini optimization").
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://motivationalwallpaper.com/#organization',
      name: 'motivationalwallpaper.com',
      url: 'https://motivationalwallpaper.com/',
      logo: 'https://motivationalwallpaper.com/favicon.svg',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://motivationalwallpaper.com/#website',
      url: 'https://motivationalwallpaper.com/',
      name: 'motivationalwallpaper.com',
      description,
      publisher: { '@id': 'https://motivationalwallpaper.com/#organization' },
    },
  ],
};
---

<BaseLayout title={title} description={description} bodyClass="screen-one">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <h1 class="sr-only">
    motivationalwallpaper — a lock screen you look forward to seeing. Join the
    community.
  </h1>

  <div class="app">
    <Reel />
    <ThemeGrid />
    <CategoryRail />
    <CategoryGrid />
    <CaptureSheet />
  </div>

  <section class="seo-blurb" aria-label="About motivationalwallpaper.com">
    <p>
      Free motivational wallpapers and inspirational quote backgrounds for
      iPhone and Android. Browse categories including gym motivation,
      self-love, faith, entrepreneurship, aesthetic, healing, and anime.
      Download your lock screen wallpaper instantly — no account required.
    </p>
  </section>
</BaseLayout>

<style>
  :global(body.screen-one) {
    overflow-x: hidden;
    overflow-y: auto;
  }

  .app {
    position: relative;
    width: 100%;
  }

  @media (min-width: 900px) {
    .app {
      display: flex;
      height: 100dvh;
      overflow: hidden;
    }
    .app :global(.reel-frame) {
      flex: 0 0 50%;
      width: 50%;
      height: 100dvh;
    }
    .app :global(.browse) {
      flex: 0 0 50%;
      width: 50%;
    }
  }

  .seo-blurb {
    padding: 28px 24px 40px;
    text-align: center;
  }
  .seo-blurb p {
    max-width: 640px;
    margin: 0 auto;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--ink-faint);
  }
</style>

<script>
  import { MW, on } from '../scripts/events';

  // The whole flow (reel -> CTA -> capture -> quiz) is self-wiring via events.
  // This is the one seam left for later: routing to the profile home.
  on(MW.quizComplete, (detail) => {
    // TODO: redirect to `/home?profile=${detail.profile}` once profile home exists.
    void detail;
  });
</script>
