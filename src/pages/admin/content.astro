---
/**
 * /admin/content — which pages and which wallpapers are doing the work.
 *
 * Unlike the traffic and audience screens, the tables here are *lifetime*
 * counters (page_stats, wallpaper_assets, world_stats), incremented as events
 * happen. They outlive raw-session retention and never miss a view to a dropped
 * exit beacon, at the cost of not being filterable by date. The date-filtered
 * version of the page table lives on /admin/traffic.
 */
export const prerender = false;

import AdminShell from '../../components/admin/AdminShell.astro';
import { requireBasicAuth } from '../../lib/adminAuth';

const denied = requireBasicAuth(Astro.request);
if (denied) return denied;

import {
  fetchTopPages,
  fetchEntryPages,
  fetchTrafficSources,
  fetchWorldStats,
  fetchMostViewedAssets,
  fetchMostDwelledAssets,
  fetchTopAssets,
  fetchRankableAssets,
  type RankableAsset,
} from '../../lib/adminData';
import { fmtDuration, fmtPct, queryString } from '../../lib/analytics/dashboard';

const query = queryString(Astro.url.searchParams);

let fetchError: string | null = null;
let topPages: Awaited<ReturnType<typeof fetchTopPages>> = [];
let entryPages: Awaited<ReturnType<typeof fetchEntryPages>> = [];
let sources: Awaited<ReturnType<typeof fetchTrafficSources>> = [];
let worlds: Awaited<ReturnType<typeof fetchWorldStats>> = [];
let mostViewed: Awaited<ReturnType<typeof fetchMostViewedAssets>> = [];
let mostDwelled: Awaited<ReturnType<typeof fetchMostDwelledAssets>> = [];
let mostDownloaded: Awaited<ReturnType<typeof fetchTopAssets>> = [];
let rankable: RankableAsset[] = [];

try {
  [topPages, entryPages, sources, worlds, mostViewed, mostDwelled, mostDownloaded, rankable] = await Promise.all([
    fetchTopPages(40),
    fetchEntryPages(25),
    fetchTrafficSources(25),
    fetchWorldStats(),
    fetchMostViewedAssets(20),
    fetchMostDwelledAssets(20),
    fetchTopAssets(20),
    fetchRankableAssets(500),
  ]);
} catch (err) {
  console.error('content dashboard query failed', err);
  fetchError = err instanceof Error ? err.message : 'Unknown error';
}

const avgDwell = (dwellMs: number, views: number) => (views > 0 ? fmtDuration(dwellMs / views) : '—');
const totalDownloads = worlds.reduce((sum, w) => sum + w.downloads, 0);
const totalWorldViews = worlds.reduce((sum, w) => sum + w.views, 0);

// Slot 0 = feed position 1 … slot 9 = position 10.
const rankedSlots: (RankableAsset | null)[] = Array.from({ length: 10 }, (_, i) =>
  rankable.find((a) => a.rank === i + 1) ?? null,
);
---

<AdminShell
  title="Admin — content & wallpapers — motivationalwallpaper.com"
  heading="Content & wallpapers"
  sub="Lifetime totals, not date-filtered. For a windowed view of pages, use the Traffic tab."
  active="content"
  query={query}
>
  {fetchError && <p class="empty">Could not read analytics: {fetchError}.</p>}

  <h2>Feed ranking <span class="hint">pin exactly which photo shows in each of the first 10 positions</span></h2>
  <div class="panel">
    <p class="sub">
      A ranked slot is fixed — every visitor sees that wallpaper in that exact position. Every other
      wallpaper fills the rest of the feed in random order. Set a wallpaper's rank from the grid below;
      clearing it (—) returns that slot to random.
    </p>
    <ol class="rank-slots">
      {rankedSlots.map((a, i) => (
        <li class="rank-slot">
          <span class="n">{i + 1}</span>
          {a ? (
            a.thumbUrl ? <img class="thumb" src={a.thumbUrl} alt="" loading="lazy" /> : <span class="thumb-missing">—</span>
          ) : (
            <span class="rank-slot-empty">random</span>
          )}
        </li>
      ))}
    </ol>

    {rankable.length === 0 ? (
      <p class="empty">No wallpapers filed under a category yet — nothing to rank.</p>
    ) : (
      <div class="scroll">
        <div class="rank-grid" id="rank-grid">
          {rankable.map((a) => (
            <figure class="rank-card" data-id={a.id}>
              {a.thumbUrl ? <img src={a.thumbUrl} alt="" loading="lazy" /> : <span class="thumb-missing">—</span>}
              <figcaption>
                <span class="cats">{a.worlds.join(', ') || 'unsorted'}</span>
                <label class="rank-field">
                  Rank
                  <select class="rankselect">
                    <option value="" selected={a.rank === null}>—</option>
                    {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => (
                      <option value={n} selected={a.rank === n}>{n}</option>
                    ))}
                  </select>
                </label>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )}
  </div>

  <h2>Pages <span class="hint">every page load since tracking began</span></h2>
  <div class="panel">
    <h3>All pages by views</h3>
    <p class="sub">
      Bot loads are counted in their own column and never included in Views. A page with more bot loads than human
      ones is being crawled but not found — usually a distribution problem, not a content one.
    </p>
    {topPages.length === 0 ? (
      <p class="empty">No page views recorded yet.</p>
    ) : (
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th>Page</th>
              <th class="num">Views</th>
              <th class="num">Avg. time</th>
              <th class="num">Avg. scroll</th>
              <th class="num">Exits</th>
              <th class="num">Bot loads</th>
            </tr>
          </thead>
          <tbody>
            {topPages.map((page) => (
              <tr>
                <td>
                  <a href={page.path} target="_blank" rel="noreferrer">{page.path}</a>
                  {page.title && <div class="muted" style="font-size:var(--t-label-size)">{page.title}</div>}
                </td>
                <td class="num">{page.views}</td>
                <td class="num">{avgDwell(page.dwellMs, page.views)}</td>
                <td class="num">{page.avgScrollPct > 0 ? fmtPct(page.avgScrollPct / 100) : '—'}</td>
                <td class="num">{page.exits}</td>
                <td class="num muted">{page.botViews}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <div class="grid" style="margin-top:18px">
    <div class="panel">
      <h3>Lifetime entry points</h3>
      <p class="sub">First page of a session, all time.</p>
      {entryPages.length === 0 ? (
        <p class="empty">No sessions recorded yet.</p>
      ) : (
        <div class="scroll">
          <table>
            <thead><tr><th>Page</th><th class="num">Sessions</th></tr></thead>
            <tbody>
              {entryPages.map((e) => (
                <tr><td>{e.path}</td><td class="num">{e.sessions}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <div class="panel">
      <h3>Lifetime referring domains</h3>
      <p class="sub">Human sessions only. "direct" means the browser sent no referrer.</p>
      {sources.length === 0 ? (
        <p class="empty">No sessions recorded yet.</p>
      ) : (
        <div class="scroll">
          <table>
            <thead><tr><th>Domain</th><th class="num">Sessions</th></tr></thead>
            <tbody>
              {sources.map((s) => (
                <tr><td>{s.bucket === 'direct' ? 'Direct / no referrer' : s.bucket}</td><td class="num">{s.sessions}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>

  <h2>Categories</h2>
  <div class="panel">
    <h3>By downloads and time on screen</h3>
    <p class="sub">
      Views count each time a wallpaper from that category became the one on screen. Download-per-view is the
      honest measure of which category actually converts attention into a saved wallpaper.
    </p>
    <div class="scroll">
      <table>
        <thead>
          <tr>
            <th>Category</th>
            <th class="num">Downloads</th>
            <th class="num">Views</th>
            <th class="num">Downloads / view</th>
            <th class="num">Avg. time on screen</th>
            <th class="num">Total time</th>
          </tr>
        </thead>
        <tbody>
          {worlds.map((w) => (
            <tr>
              <td>{w.name}</td>
              <td class="num">{w.downloads}</td>
              <td class="num">{w.views}</td>
              <td class="num">{w.views > 0 ? fmtPct(w.downloads / w.views, 1) : '—'}</td>
              <td class="num">{avgDwell(w.dwellMs, w.views)}</td>
              <td class="num">{fmtDuration(w.dwellMs)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="sub">{totalDownloads} downloads across {totalWorldViews} wallpaper views, all time.</p>
  </div>

  <h2>Wallpapers</h2>
  <div class="grid-2">
    <div class="panel">
      <h3>Most viewed</h3>
      <p class="sub">Counted every time this photo became the one on screen in the reel or category grid.</p>
      {mostViewed.length === 0 ? (
        <p class="empty">No wallpaper views recorded yet.</p>
      ) : (
        <div class="scroll">
          <table>
            <thead><tr><th>Preview</th><th>Categories</th><th class="num">Views</th><th class="num">Avg. on screen</th><th class="num">Downloads</th></tr></thead>
            <tbody>
              {mostViewed.map((a) => (
                <tr>
                  <td>{a.thumbUrl ? <img class="thumb" src={a.thumbUrl} alt="" loading="lazy" /> : '—'}</td>
                  <td>{a.worlds.join(', ') || '—'}</td>
                  <td class="num">{a.views}</td>
                  <td class="num">{avgDwell(a.dwellMs, a.views)}</td>
                  <td class="num">{a.downloads}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <div class="panel">
      <h3>Most lingered on</h3>
      <p class="sub">Total time on screen summed across every visitor — not the most seen, the most held.</p>
      {mostDwelled.length === 0 ? (
        <p class="empty">No wallpaper views recorded yet.</p>
      ) : (
        <div class="scroll">
          <table>
            <thead><tr><th>Preview</th><th>Categories</th><th class="num">Total time</th><th class="num">Views</th></tr></thead>
            <tbody>
              {mostDwelled.map((a) => (
                <tr>
                  <td>{a.thumbUrl ? <img class="thumb" src={a.thumbUrl} alt="" loading="lazy" /> : '—'}</td>
                  <td>{a.worlds.join(', ') || '—'}</td>
                  <td class="num">{fmtDuration(a.dwellMs)}</td>
                  <td class="num">{a.views}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <div class="panel">
      <h3>Most downloaded</h3>
      <p class="sub">The end of the funnel. Compare against "most viewed" — a wallpaper high in one and low in the other is telling you something.</p>
      {mostDownloaded.length === 0 ? (
        <p class="empty">No downloads recorded yet.</p>
      ) : (
        <div class="scroll">
          <table>
            <thead><tr><th>Preview</th><th>Categories</th><th>Preferred</th><th class="num">Downloads</th><th class="num">Views</th><th class="num">Rate</th></tr></thead>
            <tbody>
              {mostDownloaded.map((a) => (
                <tr>
                  <td>{a.thumbUrl ? <img class="thumb" src={a.thumbUrl} alt="" loading="lazy" /> : '—'}</td>
                  <td>{a.worlds.join(', ') || '—'}</td>
                  <td>{a.preferred ? '★' : ''}</td>
                  <td class="num">{a.downloads}</td>
                  <td class="num">{a.views}</td>
                  <td class="num">{a.views > 0 ? fmtPct(a.downloads / a.views, 1) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</AdminShell>

<style>
  .rank-slots {
    list-style: none; margin: 0 0 16px; padding: 0; display: flex; gap: 10px; flex-wrap: wrap;
  }
  .rank-slot {
    display: flex; flex-direction: column; align-items: center; gap: 4px; width: 64px;
  }
  .rank-slot .n { font-size: var(--t-label-size); font-weight: 700; color: var(--ink-faint); }
  .rank-slot img, .rank-slot .thumb-missing {
    width: 64px; aspect-ratio: 9 / 16; border-radius: 6px; object-fit: cover;
    border: 1px solid var(--hairline);
  }
  .rank-slot-empty {
    width: 64px; aspect-ratio: 9 / 16; border-radius: 6px; display: flex;
    align-items: center; justify-content: center; text-align: center;
    border: 1px dashed var(--hairline-strong); color: var(--ink-faint);
    font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .thumb-missing {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--surface-2); color: var(--ink-faint); font-size: 0.6875rem;
  }

  .rank-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 12px;
  }
  .rank-card {
    margin: 0; border: 1px solid var(--hairline); border-radius: var(--r-m);
    overflow: hidden; background: var(--surface); display: flex; flex-direction: column;
  }
  .rank-card img { width: 100%; aspect-ratio: 9 / 16; object-fit: cover; display: block; background: var(--surface-2); }
  .rank-card figcaption { padding: 8px; display: flex; flex-direction: column; gap: 6px; }
  .rank-card .cats { font-size: 0.6875rem; color: var(--ink-faint); }
  .rank-field {
    display: inline-flex; align-items: center; gap: 6px; font-size: var(--t-label-size); color: var(--ink-soft);
  }
  .rank-field select {
    font: inherit; padding: 2px 6px; border-radius: var(--r-s);
    border: 1px solid var(--hairline-strong); background: var(--paper); color: var(--ink);
  }
</style>

<script>
  const grid = document.getElementById('rank-grid');
  if (grid) {
    async function patchRank(card: HTMLElement, rank: number | null): Promise<boolean> {
      const id = card.dataset.id!;
      const select = card.querySelector<HTMLSelectElement>('.rankselect')!;
      select.disabled = true;
      let ok = false;
      try {
        const res = await fetch(`/api/wallpapers/${id}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ rank }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        ok = true;
      } catch {
        alert('Could not update rank.');
      } finally {
        select.disabled = false;
      }
      return ok;
    }

    grid.addEventListener('change', (e) => {
      const select = e.target as HTMLSelectElement;
      if (!select.classList.contains('rankselect')) return;
      const card = select.closest<HTMLElement>('.rank-card');
      if (!card) return;
      const rank = select.value === '' ? null : Number(select.value);
      void patchRank(card, rank).then((ok) => {
        if (!ok || rank === null) return;
        // The server bumps whichever other asset held this rank back to
        // unranked — mirror that here so the grid doesn't show two cards
        // claiming the same slot until a reload.
        grid.querySelectorAll<HTMLElement>('.rank-card').forEach((other) => {
          if (other === card) return;
          const sel = other.querySelector<HTMLSelectElement>('.rankselect');
          if (sel && Number(sel.value) === rank) sel.value = '';
        });
      });
    });
  }
</script>
