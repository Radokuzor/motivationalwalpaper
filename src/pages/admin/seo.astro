---
/**
 * /admin/seo — kept as a redirect. The screen that lived here grew into three:
 * Traffic (acquisition + behaviour), Audience & tech (who + what + bot audit),
 * and Content & wallpapers (lifetime page and asset totals).
 */
export const prerender = false;

import { requireBasicAuth } from '../../lib/adminAuth';

const denied = requireBasicAuth(Astro.request);
if (denied) return denied;

return Astro.redirect(`/admin/traffic${Astro.url.search}`, 302);
---
