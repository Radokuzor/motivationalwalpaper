---
/**
 * /gallery — every real uploaded photo, grouped by category (brand bible
 * Queue #2). Built entirely from `GET /api/wallpapers?feed=1` — the same
 * feed the Reel uses — so each category section shows every real photo filed
 * under it, not just one hero pick. Sections are built client-side from a
 * `<template>` since photo counts aren't known at build time. A category
 * with no upload yet renders no section at all (its `#slug` anchor from
 * SiteHeader's nav just lands on an empty spot); if nothing has been
 * uploaded anywhere, the empty state below shows instead.
 */
import ChromeLayout from '../layouts/ChromeLayout.astro';
import LockScreen from '../components/LockScreen.astro';
import { WORLDS } from '../data/worlds';

// structural chrome only (clock, dynamic island, share/preview icons, home
// indicator) — same generic template Reel.astro uses; white chrome reads on
// any real photo thanks to the .tile__art scrim below.
const TEMPLATE_WORLD = WORLDS.find((w) => w.key === 'stoic')!;
---

<ChromeLayout
  title="Gallery — browse the wallpapers — motivationalwallpaper.com"
  description="Every real wallpaper people have shared, by category."
  narrow={false}
>
  <h1>Gallery</h1>

  <p class="empty" id="gallery-empty" hidden>No wallpapers yet — check back soon.</p>

  <div class="grid" id="gallery-loading" role="status">
    {
      Array.from({ length: 9 }).map(() => (
        <div class="skel-tile mw-skel" aria-hidden="true" />
      ))
    }
    <span class="sr-only">Loading wallpapers…</span>
  </div>

  <div id="gallery-sections">
    {
      WORLDS.map((w) => (
        <section class="category" id={w.slug} data-world={w.key} hidden>
          <h2 class="category__name">{w.name}</h2>
          <div class="grid" />
        </section>
      ))
    }
  </div>

  <template id="gallery-tile-template">
    <a class="tile" href="/">
      <div class="tile__art">
        <LockScreen world={TEMPLATE_WORLD} brandTag={false} />
      </div>
    </a>
  </template>
</ChromeLayout>

<script>
  import type { WorldKey } from '../data/worlds';

  interface FeedAsset {
    id: string;
    thumbUrl: string;
    originalUrl: string;
    worlds: WorldKey[];
  }

  const emptyMsg = document.getElementById('gallery-empty') as HTMLElement;
  const loading = document.getElementById('gallery-loading') as HTMLElement;
  const template = document.getElementById('gallery-tile-template') as HTMLTemplateElement;
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.category'));

  function tileFor(asset: FeedAsset): HTMLElement {
    const frag = template.content.cloneNode(true) as DocumentFragment;
    const tile = frag.querySelector('.tile') as HTMLAnchorElement;
    const art = tile.querySelector('.tile__art') as HTMLElement;
    art.style.setProperty('--art', `url("${asset.thumbUrl}") center/cover no-repeat`);
    return tile;
  }

  fetch('/api/wallpapers?feed=1')
    .then((res) => (res.ok ? res.json() : { items: [] }))
    .then((data: { items?: FeedAsset[] }) => {
      loading.hidden = true;
      const items = data.items ?? [];
      let anyShown = false;
      sections.forEach((section) => {
        const world = section.dataset.world as WorldKey;
        const matches = items.filter((a) => a.worlds.includes(world));
        if (!matches.length) return; // no real photo for this category yet — leave it hidden
        const grid = section.querySelector('.grid') as HTMLElement;
        grid.append(...matches.map(tileFor));
        section.hidden = false;
        anyShown = true;
      });
      emptyMsg.hidden = anyShown;
    })
    .catch(() => {
      loading.hidden = true;
      emptyMsg.hidden = false;
    });
</script>

<style>
  h1 {
    font-size: var(--t-title1-size);
    font-weight: var(--t-title1-weight);
    letter-spacing: var(--t-title1-track);
    margin: 0 0 0.4rem;
  }
  .lead {
    font-size: var(--t-lead-size);
    color: var(--ink-soft);
    margin: 0 0 2rem;
  }
  .empty {
    font-size: var(--t-lead-size);
    color: var(--ink-faint);
    margin: 0 0 2rem;
  }
  .category {
    margin: 0 0 2.5rem;
    scroll-margin-top: 24px;
  }
  .category__name {
    font-size: var(--t-title2-size);
    font-weight: var(--t-title2-weight);
    letter-spacing: var(--t-title2-track);
    margin: 0 0 0.9rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }
  .tile {
    display: block;
    border: 1px solid var(--hairline);
    border-radius: var(--r-m);
    overflow: hidden;
    background: var(--surface);
  }
  .tile__art {
    position: relative;
    aspect-ratio: 9 / 16;
    background: var(--art);
  }
  .skel-tile {
    aspect-ratio: 9 / 16;
    border-radius: var(--r-m);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
    }
    .tile {
      border: none;
      border-radius: 0;
    }
    .tile__art {
      aspect-ratio: 1 / 1;
    }
    .skel-tile {
      aspect-ratio: 1 / 1;
      border-radius: 0;
    }
    /* Instagram-style grid on mobile: plain photo squares, no lock-screen
       chrome (clock/island/actions) — that mockup only reads at the larger
       phone-preview size the desktop grid uses. */
    .tile__art :global(.lock) {
      display: none;
    }
  }
</style>
