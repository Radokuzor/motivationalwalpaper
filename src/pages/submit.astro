---
/**
 * /submit — ungated operator page to upload wallpapers and file each under
 * any number of categories (the same photo can serve several). Uploads go to
 * POST /api/wallpapers (one file per request, large images downscaled
 * client-side); the grid re-files via PATCH and removes via DELETE on
 * /api/wallpapers/:id. Filing a photo under a category is enough to become
 * that category's real hero photo on the live site (reel, theme grid,
 * category grid, PNG export), replacing the CSS gradient placeholder — the
 * most recent upload wins. "Preferred" is optional: it pins a specific photo
 * as the hero even if a newer one is uploaded later — see
 * GET /api/wallpapers?hero=1.
 *
 * noindex + robots Disallow. No auth by request — keep the URL private.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { WORLDS } from '../data/worlds';
import { db } from '../lib/firebase';
import { ASSET_COLLECTION, signedUrl, thumbPath } from '../lib/wallpaperAssets';

interface Row {
  id: string;
  worlds: string[];
  preferred: boolean;
  rank: number | null;
  status: string;
  originalFilename: string | null;
  width: number;
  height: number;
  bytes: number;
  thumbUrl: string;
}

let rows: Row[] = [];
let loadError = false;
try {
  const snap = await db
    .collection(ASSET_COLLECTION)
    .orderBy('createdAt', 'desc')
    .limit(300)
    .get();
  rows = await Promise.all(
    snap.docs.map(async (d) => {
      const v = d.data();
      return {
        id: d.id,
        worlds: (v.worlds ?? []) as string[],
        preferred: v.preferred === true,
        rank: typeof v.rank === 'number' ? v.rank : null,
        status: v.status ?? 'unsorted',
        originalFilename: v.originalFilename ?? null,
        width: v.width ?? 0,
        height: v.height ?? 0,
        bytes: v.bytes ?? 0,
        thumbUrl: await signedUrl(v.storageThumb ?? thumbPath(d.id)),
      };
    }),
  );
} catch (err) {
  console.error('submit: asset list failed', err);
  loadError = true;
}

const counts: Record<string, number> = { unsorted: 0 };
for (const w of WORLDS) counts[w.key] = 0;
for (const r of rows) {
  if (r.worlds.length === 0) counts.unsorted++;
  else for (const k of r.worlds) counts[k] = (counts[k] ?? 0) + 1;
}

const kb = (n: number) => `${Math.round(n / 1024)} KB`;

// Slot 0 = position 1 … slot 9 = position 10, for the "Top 10" overview.
const rankedSlots: (Row | null)[] = Array.from({ length: 10 }, (_, i) =>
  rows.find((r) => r.rank === i + 1) ?? null,
);
---

<BaseLayout title="Submit wallpapers — motivationalwallpaper.com" description="Operator upload" noindex>
  <main class="wrap">
    <header class="head">
      <h1>Submit wallpapers</h1>
      <p class="sub">
        Pick one or more categories, drop images in — the same photo can
        belong to several, and it goes live on the site right away as that
        category's real wallpaper. Mark it Preferred only if you want to pin
        it over whatever you upload next. Change categories or delete right
        from the grid.
      </p>
    </header>

    <form id="up" class="uploader" method="post" action="/api/wallpapers" enctype="multipart/form-data">
      <div class="row">
        <fieldset class="cats">
          <legend>Categories</legend>
          {
            WORLDS.map((w) => (
              <label class="catbox">
                <input type="checkbox" name="world" value={w.key} data-name={w.name} />
                {w.name}
              </label>
            ))
          }
          <label class="catbox pref">
            <input type="checkbox" name="preferred" value="1" />
            ★ Preferred
          </label>
        </fieldset>
        <label class="field grow">
          <span>Images</span>
          <input type="file" name="file" id="file" accept="image/*" multiple required />
        </label>
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        <button type="submit" id="go">Upload</button>
      </div>
      <p class="hint" id="hint">jpeg / png / webp / avif · short edge ≥ 500px · no category checked = unsorted</p>
      <ul class="queue" id="queue" hidden></ul>
    </form>

    <section class="top10">
      <h2>Top 10 feed order</h2>
      <p class="sub">
        These positions are pinned — a visitor sees them in this exact order
        first. Every other wallpaper fills the rest of the feed at random.
        Set a wallpaper's rank from its card below; an empty slot is filled
        by a random photo.
      </p>
      <ol class="slots">
        {rankedSlots.map((r, i) => (
          <li class="slot">
            <span class="n">{i + 1}</span>
            {r ? (
              <img src={r.thumbUrl} alt={r.originalFilename ?? r.id} loading="lazy" />
            ) : (
              <span class="empty-slot">random</span>
            )}
          </li>
        ))}
      </ol>
    </section>

    <section class="tally">
      {[{ key: 'unsorted', name: 'Unsorted' }, ...WORLDS].map((w) => (
        <span class="chip"><b>{counts[w.key] ?? 0}</b> {w.name}</span>
      ))}
    </section>

    {loadError && <p class="err">Could not load existing assets. Check the server logs / Storage config.</p>}

    <section class="grid" id="grid">
      {rows.map((r) => (
        <figure class="card" data-id={r.id}>
          <img src={r.thumbUrl} alt={r.originalFilename ?? r.id} loading="lazy" />
          <figcaption>
            <fieldset class="recat" aria-label="Categories">
              {WORLDS.map((w) => (
                <label>
                  <input type="checkbox" value={w.key} checked={r.worlds.includes(w.key)} />
                  {w.name}
                </label>
              ))}
            </fieldset>
            <label class="pref">
              <input type="checkbox" class="prefbox" checked={r.preferred} />
              ★ Preferred
            </label>
            <label class="rank">
              Rank
              <select class="rankselect">
                <option value="" selected={r.rank === null}>—</option>
                {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => (
                  <option value={n} selected={r.rank === n}>{n}</option>
                ))}
              </select>
            </label>
            <span class="meta">{r.width}×{r.height} · {kb(r.bytes)}</span>
            <button type="button" class="del" aria-label="Delete">Delete</button>
          </figcaption>
        </figure>
      ))}
    </section>
    {rows.length === 0 && !loadError && <p class="empty">Nothing uploaded yet.</p>}
  </main>
</BaseLayout>

<style>
  .wrap { padding: 40px 24px 80px; max-width: 1100px; margin: 0 auto; }
  .head h1 {
    font-size: var(--t-title1-size); font-weight: var(--t-title1-weight);
    letter-spacing: var(--t-title1-track); margin: 0 0 0.35rem;
  }
  .sub { color: var(--ink-soft); margin: 0 0 1.75rem; max-width: 60ch; font-size: var(--t-small-size); }

  .uploader {
    border: 1px solid var(--hairline); border-radius: var(--r-m);
    background: var(--surface); padding: 18px; margin-bottom: 1.5rem;
  }
  .row { display: flex; gap: 14px; align-items: flex-end; flex-wrap: wrap; }
  .field { display: flex; flex-direction: column; gap: 6px; font-size: var(--t-label-size);
    font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
    text-transform: uppercase; color: var(--ink-faint); }
  .field.grow { flex: 1; min-width: 220px; }

  .cats {
    display: flex; flex-wrap: wrap; gap: 8px 14px; border: 0; padding: 0; margin: 0;
    min-width: 260px;
  }
  .cats legend {
    width: 100%; font-size: var(--t-label-size); font-weight: var(--t-label-weight);
    letter-spacing: var(--t-label-track); text-transform: uppercase; color: var(--ink-faint);
    padding: 0 0 6px;
  }
  .catbox {
    display: inline-flex; align-items: center; gap: 5px; font-size: var(--t-small-size);
    color: var(--ink); cursor: pointer; white-space: nowrap;
  }
  .catbox.pref { padding-left: 10px; border-left: 1px solid var(--hairline); }
  input[type='file'] {
    font: inherit; text-transform: none; letter-spacing: normal; color: var(--ink);
    background: var(--paper); border: 1px solid var(--hairline-strong);
    border-radius: var(--r-s); padding: 8px 10px;
  }
  button {
    font: inherit; font-weight: 600; cursor: pointer; color: var(--surface);
    background: var(--ink); border: 0; border-radius: var(--r-s); padding: 10px 18px;
  }
  button:disabled { opacity: 0.5; cursor: default; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .hint { margin: 12px 0 0; font-size: var(--t-small-size); color: var(--ink-faint); }

  .queue { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 6px; }
  .queue li { font-size: var(--t-small-size); display: flex; gap: 8px; align-items: center; }
  .queue .s-ok { color: var(--accent-strong); }
  .queue .s-err { color: #b4341f; }
  .queue .s-run { color: var(--ink-faint); }

  .top10 { margin-bottom: 1.5rem; }
  .top10 h2 {
    font-size: var(--t-title2-size, 1.1rem); margin: 0 0 0.35rem;
  }
  .top10 .sub { margin: 0 0 12px; max-width: 70ch; font-size: var(--t-small-size); color: var(--ink-soft); }
  .slots {
    list-style: none; margin: 0; padding: 0; display: flex; gap: 10px; flex-wrap: wrap;
  }
  .slot {
    display: flex; flex-direction: column; align-items: center; gap: 4px; width: 64px;
  }
  .slot .n {
    font-size: var(--t-label-size); font-weight: 700; color: var(--ink-faint);
  }
  .slot img {
    width: 64px; aspect-ratio: 9 / 16; object-fit: cover; border-radius: 6px;
    border: 1px solid var(--hairline);
  }
  .empty-slot {
    width: 64px; aspect-ratio: 9 / 16; border-radius: 6px; display: flex;
    align-items: center; justify-content: center; text-align: center;
    border: 1px dashed var(--hairline-strong); color: var(--ink-faint);
    font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.04em;
  }

  .tally { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 1.5rem; }
  .chip {
    font-size: var(--t-small-size); color: var(--ink-soft);
    border: 1px solid var(--hairline); border-radius: var(--r-pill); padding: 4px 12px;
  }
  .chip b { color: var(--ink); }

  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }
  .card {
    margin: 0; border: 1px solid var(--hairline); border-radius: var(--r-m);
    overflow: hidden; background: var(--surface); display: flex; flex-direction: column;
  }
  .card img { width: 100%; aspect-ratio: 9 / 16; object-fit: cover; display: block; background: var(--surface-2); }
  .card.gone { opacity: 0.35; pointer-events: none; }
  figcaption { padding: 10px; display: flex; flex-direction: column; gap: 6px; }
  .recat {
    display: flex; flex-wrap: wrap; gap: 4px 8px; border: 0; padding: 0; margin: 0;
    font-size: 0.75rem;
  }
  .recat label { display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; }
  .pref { display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--ink-soft); }
  .rank {
    display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; color: var(--ink-soft);
  }
  .rank select {
    font: inherit; padding: 2px 6px; border-radius: var(--r-s);
    border: 1px solid var(--hairline-strong); background: var(--paper); color: var(--ink);
  }
  .meta { font-size: 0.6875rem; color: var(--ink-faint); }
  .del {
    background: none; color: #b4341f; border: 1px solid var(--hairline-strong);
    padding: 5px 0; font-size: var(--t-small-size); font-weight: 500;
  }
  .del:hover { border-color: #b4341f; }

  .empty, .err { color: var(--ink-faint); font-size: var(--t-small-size); }
  .err { color: #b4341f; }
</style>

<script>
  const form = document.getElementById('up') as HTMLFormElement;
  const fileInput = document.getElementById('file') as HTMLInputElement;
  const goBtn = document.getElementById('go') as HTMLButtonElement;
  const queue = document.getElementById('queue') as HTMLUListElement;
  const grid = document.getElementById('grid') as HTMLElement;
  const catInputs = Array.from(
    form.querySelectorAll<HTMLInputElement>('.cats input[name="world"]'),
  );
  const preferredInput = form.querySelector<HTMLInputElement>('.cats input[name="preferred"]')!;

  const WORLD_LABEL: Record<string, string> = {};
  catInputs.forEach((cb) => {
    WORLD_LABEL[cb.value] = cb.dataset.name || cb.value;
  });

  function catFieldset(worlds: string[]): string {
    return Object.entries(WORLD_LABEL)
      .map(
        ([value, label]) =>
          `<label><input type="checkbox" value="${value}"${worlds.includes(value) ? ' checked' : ''} /> ${label}</label>`,
      )
      .join('');
  }

  const MAX_EDGE = 2960; // keep uploads comfortably under Vercel's body limit
  const SIZE_TRIGGER = 3_800_000;

  /** Downscale + re-encode large images to JPEG in the browser. */
  async function shrink(file: File): Promise<Blob> {
    if (file.size < SIZE_TRIGGER) return file;
    const bmp = await createImageBitmap(file).catch(() => null);
    if (!bmp) return file;
    const scale = Math.min(1, MAX_EDGE / Math.max(bmp.width, bmp.height));
    if (scale === 1 && file.type === 'image/jpeg') {
      bmp.close();
      return file;
    }
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bmp.width * scale);
    canvas.height = Math.round(bmp.height * scale);
    canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
    bmp.close();
    return new Promise((res) =>
      canvas.toBlob((b) => res(b ?? file), 'image/jpeg', 0.92),
    );
  }

  function addCard(r: any) {
    const worlds: string[] = r.worlds ?? [];
    const existing = grid.querySelector<HTMLElement>(`[data-id="${r.id}"]`);
    if (existing) {
      // already on the page — just re-sync its categories + preferred flag
      existing
        .querySelectorAll<HTMLInputElement>('.recat input[type="checkbox"]')
        .forEach((cb) => (cb.checked = worlds.includes(cb.value)));
      const pref = existing.querySelector<HTMLInputElement>('.prefbox');
      if (pref) pref.checked = !!r.preferred;
      return;
    }
    const fig = document.createElement('figure');
    fig.className = 'card';
    fig.dataset.id = r.id;
    const rankOptions = Array.from({ length: 10 }, (_, i) => i + 1)
      .map((n) => `<option value="${n}">${n}</option>`)
      .join('');
    fig.innerHTML = `
      <img src="${r.thumbUrl}" alt="${r.filename ?? r.id}" loading="lazy" />
      <figcaption>
        <fieldset class="recat" aria-label="Categories">${catFieldset(worlds)}</fieldset>
        <label class="pref"><input type="checkbox" class="prefbox"${r.preferred ? ' checked' : ''} /> ★ Preferred</label>
        <label class="rank">Rank <select class="rankselect"><option value="">—</option>${rankOptions}</select></label>
        <span class="meta">just uploaded</span>
        <button type="button" class="del" aria-label="Delete">Delete</button>
      </figcaption>`;
    grid.prepend(fig);
    document.querySelector('.empty')?.remove();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const files = Array.from(fileInput.files ?? []);
    if (!files.length) return;
    const worlds = catInputs.filter((cb) => cb.checked).map((cb) => cb.value);
    const preferred = preferredInput.checked;
    goBtn.disabled = true;
    queue.hidden = false;
    queue.innerHTML = '';

    for (const file of files) {
      const li = document.createElement('li');
      li.innerHTML = `<span class="s-run">…</span> ${file.name}`;
      queue.append(li);
      const status = li.querySelector('span')!;
      try {
        const blob = await shrink(file);
        const fd = new FormData();
        worlds.forEach((w) => fd.append('world', w));
        if (preferred) fd.append('preferred', '1');
        fd.append('file', blob, file.name);
        const res = await fetch('/api/wallpapers', {
          method: 'POST',
          headers: { accept: 'application/json' },
          body: fd,
        });
        const data = await res.json();
        const r = data.results?.[0];
        if (r?.ok) {
          status.className = 's-ok';
          status.textContent = '✓';
          addCard({ ...r, filename: file.name });
        } else {
          status.className = 's-err';
          status.textContent = r?.error || data.error || `HTTP ${res.status}`;
        }
      } catch (err) {
        status.className = 's-err';
        status.textContent = (err as Error).message;
      }
    }

    goBtn.disabled = false;
    fileInput.value = '';
  });

  // Grid: re-file categories, toggle preferred, set rank, remove on delete.
  async function patchCard(card: HTMLElement, body: Record<string, unknown>): Promise<boolean> {
    const id = card.dataset.id!;
    const controls = card.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      'input[type="checkbox"], select',
    );
    controls.forEach((i) => (i.disabled = true));
    let ok = false;
    try {
      const res = await fetch(`/api/wallpapers/${id}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      ok = true;
    } catch {
      alert('Could not update.');
    } finally {
      controls.forEach((i) => (i.disabled = false));
    }
    return ok;
  }

  grid.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement | HTMLSelectElement;
    const card = el.closest('.card') as HTMLElement | null;
    if (!card) return;
    if (el.closest('.recat')) {
      const worlds = Array.from(
        card.querySelectorAll<HTMLInputElement>('.recat input[type="checkbox"]:checked'),
      ).map((cb) => cb.value);
      void patchCard(card, { worlds });
    } else if (el.classList.contains('prefbox')) {
      void patchCard(card, { preferred: (el as HTMLInputElement).checked });
    } else if (el.classList.contains('rankselect')) {
      const select = el as HTMLSelectElement;
      const rank = select.value === '' ? null : Number(select.value);
      void patchCard(card, { rank }).then((ok) => {
        if (!ok || rank === null) return;
        // The server bumps whichever other asset held this rank back to
        // unranked — mirror that here so the grid doesn't show two cards
        // claiming the same slot until a reload.
        grid.querySelectorAll<HTMLElement>('.card').forEach((other) => {
          if (other === card) return;
          const sel = other.querySelector<HTMLSelectElement>('.rankselect');
          if (sel && Number(sel.value) === rank) sel.value = '';
        });
      });
    }
  });

  grid.addEventListener('click', async (e) => {
    const btn = e.target as HTMLElement;
    if (!btn.classList.contains('del')) return;
    const card = btn.closest('.card') as HTMLElement;
    const id = card.dataset.id!;
    if (!confirm('Delete this wallpaper?')) return;
    card.classList.add('gone');
    try {
      const res = await fetch(`/api/wallpapers/${id}`, { method: 'DELETE' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      card.remove();
    } catch {
      card.classList.remove('gone');
      alert('Could not delete.');
    }
  });
</script>
