rules_version = '2';
// Deny ALL client access. Every read/write goes through the Firebase Admin SDK
// server-side (src/lib/firebase.ts, used by src/pages/api/survey.ts). Apply these
// in the Firebase console: Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
